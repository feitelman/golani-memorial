# ── Mapbox ──────────────────────────────────────────────
# Get a free token at https://account.mapbox.com/access-tokens/
# Without a token the map falls back to a stylized tactical grid (still works).
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Supabase ────────────────────────────────────────────
# https://app.supabase.com → Project Settings → API
# Without these, the app reads from the bundled example data in /lib/seed-data.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for the admin dashboard write operations.
# NEVER expose this with NEXT_PUBLIC_. Keep it on the server.
SUPABASE_SERVICE_ROLE_KEY=
